# Plantilla documental: PHP usa getenv(); NO carga archivos .env automáticamente.
# Definir estas variables en el proceso PHP/servidor. No completar este ejemplo
# con secretos ni colocar cuentas de servicio dentro del directorio público.
# Copiar los valores públicos exactos desde la app Web oficial en Firebase.
CHICHEJ_FIREBASE_API_KEY=
CHICHEJ_FIREBASE_AUTH_DOMAIN=
CHICHEJ_FIREBASE_DATABASE_URL=
CHICHEJ_FIREBASE_PROJECT_ID=
CHICHEJ_FIREBASE_APP_ID=
CHICHEJ_FIREBASE_MESSAGING_SENDER_ID=
# Ruta absoluta a un archivo privado FUERA del repositorio y del directorio público.
CHICHEJ_FIREBASE_SERVICE_ACCOUNT=

CHICHEJ_MAIL_HOST=
CHICHEJ_MAIL_PORT=587
CHICHEJ_MAIL_USERNAME=
CHICHEJ_MAIL_PASSWORD=
CHICHEJ_MAIL_ENCRYPTION=tls
CHICHEJ_MAIL_FROM_ADDRESS=
CHICHEJ_MAIL_FROM_NAME="Sitio web CHICHEJ"
CHICHEJ_MAIL_TO_ADDRESS=
